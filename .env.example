# codex-lb runs with zero configuration — every value below is optional and
# commented out. Uncomment only what a docs page for your scenario tells you to.
# Configuration guide: https://soju06.github.io/codex-lb/configuration/

# Where codex-lb stores its data (database, encryption key, archives).
# Default: ~/.codex-lb (host) or /var/lib/codex-lb (Docker).
# CODEX_LB_DATA_DIR=~/.codex-lb

# Listen port (default 2455) — host (uvx/local) runs only, and only as a
# process environment variable (not via .env.local, which maps CODEX_LB_-
# prefixed variables only). In Docker the container always listens on 2455
# (the entrypoint pins --port 2455); change the HOST side of the compose
# ports mapping instead, e.g. "8080:2455".
# PORT=2455

# Database. SQLite (default) needs nothing. For PostgreSQL:
# CODEX_LB_DATABASE_URL=postgresql+asyncpg://codex_lb:codex_lb@127.0.0.1:5432/codex_lb

# Upstream ChatGPT base URL (no /codex suffix)
CODEX_LB_UPSTREAM_BASE_URL=https://chatgpt.com/backend-api

# Claude sidecar via CLIProxyAPI (disabled by default)
CODEX_LB_CLAUDE_SIDECAR_ENABLED=false
CODEX_LB_CLAUDE_SIDECAR_BASE_URL=http://127.0.0.1:8317
# CODEX_LB_CLAUDE_SIDECAR_API_KEY=
CODEX_LB_CLAUDE_SIDECAR_MODEL_PREFIXES=claude
CODEX_LB_CLAUDE_SIDECAR_CONNECT_TIMEOUT_SECONDS=8
CODEX_LB_CLAUDE_SIDECAR_REQUEST_TIMEOUT_SECONDS=600
CODEX_LB_CLAUDE_SIDECAR_MODELS_CACHE_TTL_SECONDS=60

# OpenRouter sidecar (direct API). Configure explicit model prefixes to avoid routing native Codex models.
CODEX_LB_OPENROUTER_SIDECAR_ENABLED=false
CODEX_LB_OPENROUTER_SIDECAR_BASE_URL=https://openrouter.ai/api/v1
# CODEX_LB_OPENROUTER_SIDECAR_API_KEY=
# CODEX_LB_OPENROUTER_SIDECAR_MODEL_PREFIXES=deepseek/,google/
CODEX_LB_OPENROUTER_SIDECAR_CONNECT_TIMEOUT_SECONDS=8
CODEX_LB_OPENROUTER_SIDECAR_REQUEST_TIMEOUT_SECONDS=600
CODEX_LB_OPENROUTER_SIDECAR_MODELS_CACHE_TTL_SECONDS=60

# OrcaRouter sidecar (direct API). Seeded prefix orcarouter/ is forwarded unchanged.
CODEX_LB_ORCAROUTER_SIDECAR_ENABLED=false
CODEX_LB_ORCAROUTER_SIDECAR_BASE_URL=https://api.orcarouter.ai/v1
# CODEX_LB_ORCAROUTER_SIDECAR_API_KEY=
# Seeds the stored prefixes when the settings row is first created. Set to an
# empty value to seed none, e.g. when another enabled integration owns orcarouter/.
CODEX_LB_ORCAROUTER_SIDECAR_MODEL_PREFIXES=orcarouter/
CODEX_LB_ORCAROUTER_SIDECAR_CONNECT_TIMEOUT_SECONDS=8
CODEX_LB_ORCAROUTER_SIDECAR_REQUEST_TIMEOUT_SECONDS=600
CODEX_LB_ORCAROUTER_SIDECAR_MODELS_CACHE_TTL_SECONDS=60

# OmniRoute sidecar. DISABLED as a product integration: these settings are
# retained for a future re-enable but have no effect, and setting ENABLED=true
# does not expose or route to OmniRoute. See app/core/config/product_capabilities.py.
CODEX_LB_OMNIROUTE_SIDECAR_ENABLED=false
CODEX_LB_OMNIROUTE_SIDECAR_BASE_URL=http://127.0.0.1:20128/v1
# CODEX_LB_OMNIROUTE_SIDECAR_API_KEY=
# CODEX_LB_OMNIROUTE_SIDECAR_SELECTED_MODELS=oc/big-pickle,oc/deepseek-v4-flash-free
CODEX_LB_OMNIROUTE_SIDECAR_CONNECT_TIMEOUT_SECONDS=8
CODEX_LB_OMNIROUTE_SIDECAR_REQUEST_TIMEOUT_SECONDS=600
CODEX_LB_OMNIROUTE_SIDECAR_MODELS_CACHE_TTL_SECONDS=60

# Ollama Cloud sidecar. Configure explicit cloud model IDs or prefixes.
CODEX_LB_OLLAMA_SIDECAR_ENABLED=false
CODEX_LB_OLLAMA_SIDECAR_BASE_URL=https://ollama.com
# CODEX_LB_OLLAMA_SIDECAR_API_KEY=
# CODEX_LB_OLLAMA_SIDECAR_MODEL_PREFIXES=ollama-
# CODEX_LB_OLLAMA_SIDECAR_FULL_MODELS=gpt-oss:120b-cloud
CODEX_LB_OLLAMA_SIDECAR_CONNECT_TIMEOUT_SECONDS=8
CODEX_LB_OLLAMA_SIDECAR_REQUEST_TIMEOUT_SECONDS=600
CODEX_LB_OLLAMA_SIDECAR_MODELS_CACHE_TTL_SECONDS=60

# Timeouts (seconds)
CODEX_LB_UPSTREAM_CONNECT_TIMEOUT_SECONDS=30
CODEX_LB_PROXY_REQUEST_BUDGET_SECONDS=600
CODEX_LB_HTTP_RESPONSES_SESSION_BRIDGE_REQUEST_BUDGET_SECONDS=7200
CODEX_LB_STREAM_IDLE_TIMEOUT_SECONDS=300
# Upstream websocket handshakes auto-use proxy env vars when available.
# wss_proxy=
# ws_proxy=
# https_proxy=
# http_proxy=
# all_proxy=

# Set this explicitly to false only if websocket handshakes must bypass env proxies.
# CODEX_LB_UPSTREAM_WEBSOCKET_TRUST_ENV=false

# Warmup
CODEX_LB_WARMUP_MODEL=gpt-5.4-mini

# OAuth / token refresh
CODEX_LB_AUTH_BASE_URL=https://auth.openai.com
CODEX_LB_OAUTH_CLIENT_ID=app_EMoamEEZ73f0CkXaXp7hrann
CODEX_LB_OAUTH_SCOPE="openid profile email"
CODEX_LB_OAUTH_TIMEOUT_SECONDS=30
CODEX_LB_OAUTH_REDIRECT_URI=http://localhost:1455/auth/callback
CODEX_LB_OAUTH_CALLBACK_HOST=127.0.0.1
# Do not change the port. OpenAI dislikes changes.
CODEX_LB_OAUTH_CALLBACK_PORT=1455
CODEX_LB_TOKEN_REFRESH_TIMEOUT_SECONDS=30
CODEX_LB_TOKEN_REFRESH_INTERVAL_DAYS=8

# Encryption key file (pin for Docker volumes; must be shared across replicas).
# CODEX_LB_ENCRYPTION_KEY_FILE=/var/lib/codex-lb/encryption.key

# Dashboard auth: standard (password + TOTP, default) | trusted_header | disabled
# https://soju06.github.io/codex-lb/authentication/
# CODEX_LB_DASHBOARD_AUTH_MODE=standard
# CODEX_LB_DASHBOARD_AUTH_PROXY_HEADER=Remote-User

# Behind a reverse proxy? Trust X-Forwarded-For from these sources only:
# https://soju06.github.io/codex-lb/deployment/remote/
# CODEX_LB_FIREWALL_TRUST_PROXY_HEADERS=true
# CODEX_LB_FIREWALL_TRUSTED_PROXY_CIDRS=172.18.0.0/16

# Fixed dashboard bootstrap token for first remote login (default: auto-generated,
# printed to logs). https://soju06.github.io/codex-lb/getting-started/
# CODEX_LB_DASHBOARD_BOOTSTRAP_TOKEN=your-secret-token

# OAuth login callback bind host (auto-detected: 0.0.0.0 in containers).
# CODEX_LB_OAUTH_CALLBACK_HOST=0.0.0.0

# Leader election is enabled by default and required for multi-replica/multi-worker
# deployments. Uncomment to opt OUT (single-instance deployments only).
# CODEX_LB_LEADER_ELECTION_ENABLED=false

# Everything else (timeouts, pools, bulkheads, session bridge, observability) is an
# advanced setting with tested defaults. Do not tune it unless the docs page for
# your scenario says so. Full generated reference of every variable:
# https://soju06.github.io/codex-lb/reference/settings/
